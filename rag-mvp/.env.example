# --- RAG module (local MVP) -------------------------------------------------
# Retrieval backend: "local" (TF-IDF, no credentials) or "azure" (not implemented yet)
RAG_BACKEND=local
# Folder containing the *-KB-001.md files (default: ./knowledgebase)
# RAG_KB_DIR=knowledgebase
# Minimum relevance score; results below it are dropped (returns [] if none remain)
RAG_MIN_SCORE=0.12

# --- Azure AI Search / embeddings (reserved for the Azure backend; leave blank) ---
# AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# AZURE_SEARCH_API_KEY=
# AZURE_SEARCH_INDEX_NAME=omnidesk-kb
# AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
